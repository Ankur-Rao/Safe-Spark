# Supabase — create a project at https://supabase.com, then paste the values here
# and rename this file to .env.local (Vite only exposes VITE_* vars to the client).
#
# Leave these blank and SafeSpark runs in DEMO MODE: all data is served from
# /src/data and persisted to localStorage, so the whole app still works offline.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: your Amazon Associates tag. Blank = clean, untagged product links.
VITE_AFFILIATE_TAG=
